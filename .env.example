# AgriSense AI Environment Variables
# Copy to .env for local development

# Optional: Gemini AI API Key for real-time vision diagnosis
# If left blank, AgriSense AI seamlessly uses intelligent local vision presets & mock vision classifier
VITE_GEMINI_API_KEY=

# Optional: Custom Weather API key if using paid provider (Open-Meteo works free out of the box without key)
VITE_WEATHER_API_KEY=

# Optional: Enable Demo Mode by default (true/false)
VITE_ENABLE_DEMO_MODE=true
